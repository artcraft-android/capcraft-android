--- a/libavcodec/mediacodec_sw_buffer.c	2023-11-10 06:38:51
+++ b/libavcodec/mediacodec_sw_buffer.c	2026-11-11 20:01:07
@@ -177,6 +177,54 @@
 }
 
 
+/**
+ * P010: the layout of YUV420SemiPlanar with every sample in two bytes,
+ * little-endian, the ten bits in the high end - AV_PIX_FMT_P010 as it is.
+ * The stride is in bytes; a decoder that reports it in samples is caught
+ * by a stride too short to hold a row.
+ */
+void ff_mediacodec_sw_buffer_copy_p010(AVCodecContext *avctx,
+                                       MediaCodecDecContext *s,
+                                       uint8_t *data,
+                                       size_t size,
+                                       FFAMediaCodecBufferInfo *info,
+                                       AVFrame *frame)
+{
+    int i;
+    int stride = s->stride < avctx->width * 2 ? s->stride * 2 : s->stride;
+
+    for (i = 0; i < 2; i++) {
+        int j, height;
+        int width = FFMIN(frame->linesize[i], FFALIGN(avctx->width, 2) * 2);
+        uint8_t *src = data + info->offset;
+        uint8_t *dst = frame->data[i];
+
+        if (i == 0) {
+            height = avctx->height;
+            width  = FFMIN(frame->linesize[i], avctx->width * 2);
+        } else {
+            height = avctx->height / 2;
+            src += s->slice_height * stride;
+        }
+        src += (s->crop_top >> i) * stride;
+        src += s->crop_left * 2;
+
+        if ((src - data) + (size_t)(height - 1) * stride + width > size) {
+            av_log(avctx, AV_LOG_ERROR, "P010 buffer is shorter than its picture\n");
+            return;
+        }
+
+        if (frame->linesize[i] == stride) {
+            memcpy(dst, src, (size_t)(height - 1) * stride + width);
+        } else {
+            for (j = 0; j < height; j++) {
+                memcpy(dst, src, width);
+                src += stride;
+                dst += frame->linesize[i];
+            }
+        }
+    }
+}
 
 void ff_mediacodec_sw_buffer_copy_yuv420_packed_semi_planar(AVCodecContext *avctx,
                                                             MediaCodecDecContext *s,
